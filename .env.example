# Copy this file to /etc/nutanix-dr/.env  (chmod 600, owned by the service user)
# NEVER commit the real .env to git or leave it world-readable.

# ---- HQ health check target ----
# The HQ Nutanix cluster/PC address the monitor polls to decide if HQ is down.
HQ_HOST=10.66.1.202
HQ_CHECK_PORT=9440
HQ_CHECK_TIMEOUT_SECONDS=5
HQ_CHECK_INTERVAL_SECONDS=30
# Number of CONSECUTIVE failed checks required before a failover is triggered.
# 5 checks x 30s interval = ~2.5 minutes of confirmed downtime before action.
HQ_FAILURE_THRESHOLD=5

# ---- Nutanix Prism Central API used to execute the recovery plan ----
# This is normally the DR-site Prism Central, since it must still be reachable
# when HQ is down.
PC_API_HOST=10.66.2.235
PC_API_PORT=9440
# Use a DEDICATED, scoped API user here (execute recovery plans / read only) -
# do NOT use the main admin account for this service.
PC_API_USER=changeme
PC_API_PASSWORD=changeme
PC_API_VERIFY_SSL=false

# ---- Recovery plan identification ----
# Either set the UUID directly, or set the NAME and the app will look up the UUID.
RECOVERY_PLAN_UUID=
RECOVERY_PLAN_NAME=testrecovery2

# ---- Availability zone URLs used in the failover execution request ----
FAILED_AVAILABILITY_ZONE_URL=463022d5-0747-40cd-b5e9-8b3e046e1435
RECOVERY_AVAILABILITY_ZONE_URL=38926d0d-3d12-482d-a392-9cae08b9c731

# ---- App/web ----
FLASK_SECRET_KEY=change-this-to-a-random-value
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=/var/lib/nutanix-dr/state.db
LOG_PATH=/var/log/nutanix-dr/app.log

# ---- Optional: notification webhook (Slack/Teams incoming webhook URL) ----
NOTIFY_WEBHOOK_URL=
